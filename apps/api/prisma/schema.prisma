generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------
// ENUMS
// ------------------------------

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF

  @@map("user_role")
}

enum BookingType {
  BOOK_VISIT
  REQUEST_QUOTE
  ENQUIRY

  @@map("booking_type")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED

  @@map("booking_status")
}

enum EnquiryType {
  REQUEST_QUOTE
  GENERAL_ENQUIRY

  @@map("enquiry_type")
}

enum EnquiryStatus {
  NEW
  UNDER_REVIEW
  CONTACTED
  QUOTATION_SENT
  ACCEPTED
  CLOSED
  REJECTED

  @@map("enquiry_status")
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED

  @@map("quotation_status")
}

// ------------------------------
// CUSTOMER PROFILES
// ------------------------------

model Profile {
  id       String   @id @db.Uuid
  fullName String?  @map("full_name") @db.VarChar(160)
  phone    String?  @unique @db.VarChar(20)
  role     UserRole @default(CUSTOMER)
  isActive Boolean  @default(true) @map("is_active")

  addresses     Address[]
  bookings      Booking[]
  enquiries     Enquiry[]
  statusChanges BookingStatusHistory[] @relation("BookingStatusChangedBy")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

// ------------------------------
// CUSTOMER ADDRESSES
// ------------------------------

model Address {
  id        String @id @default(uuid()) @db.Uuid
  profileId String @map("profile_id") @db.Uuid

  label    String? @db.VarChar(50)
  line1    String  @map("line_1") @db.VarChar(255)
  line2    String? @map("line_2") @db.VarChar(255)
  landmark String? @db.VarChar(150)

  city       String @db.VarChar(100)
  state      String @db.VarChar(100)
  postalCode String @map("postal_code") @db.VarChar(12)
  country    String @default("India") @db.VarChar(100)

  isDefault Boolean @default(false) @map("is_default")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  bookings Booking[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([profileId])
  @@map("addresses")
}

// ------------------------------
// SERVICE CATEGORIES
// ------------------------------

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(150)
  slug        String  @unique @db.VarChar(180)
  description String? @db.Text
  imageUrl    String? @map("image_url") @db.Text

  parentId String? @map("parent_id") @db.Uuid

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  parent Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)

  children Category[] @relation("CategoryTree")
  services Service[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

// ------------------------------
// SERVICES
// ------------------------------

model Service {
  id         String @id @default(uuid()) @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  name             String  @db.VarChar(180)
  slug             String  @unique @db.VarChar(200)
  shortDescription String? @map("short_description") @db.VarChar(300)
  description      String? @db.Text
  imageUrl         String? @map("image_url") @db.Text

  bookingType BookingType @default(REQUEST_QUOTE) @map("booking_type")

  basePrice       Decimal? @map("base_price") @db.Decimal(12, 2)
  currency        String   @default("INR") @db.Char(3)
  durationMinutes Int?     @map("duration_minutes")

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  locations         ServiceLocation[]
  bookings          Booking[]
  availabilitySlots AvailabilitySlot[]
  enquiries         Enquiry[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([isActive, sortOrder])
  @@map("services")
}

// ------------------------------
// SERVICE LOCATIONS
// ------------------------------

model Location {
  id String @id @default(uuid()) @db.Uuid

  city    String @db.VarChar(100)
  state   String @db.VarChar(100)
  country String @default("India") @db.VarChar(100)

  slug     String  @unique @db.VarChar(180)
  isActive Boolean @default(true) @map("is_active")

  services          ServiceLocation[]
  bookings          Booking[]
  availabilitySlots AvailabilitySlot[]
  enquiries         Enquiry[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("locations")
}

model ServiceLocation {
  serviceId  String @map("service_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid

  isActive Boolean @default(true) @map("is_active")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([serviceId, locationId])
  @@index([locationId])
  @@map("service_locations")
}

// ------------------------------
// INITIAL SYSTEM CHECK
// ------------------------------

model SystemCheck {
  id        String   @id @default(uuid())
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_checks")
}

model AvailabilitySlot {
  id         String @id @default(uuid()) @db.Uuid
  serviceId  String @map("service_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid

  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)

  capacity    Int     @default(1)
  bookedCount Int     @default(0) @map("booked_count")
  isActive    Boolean @default(true) @map("is_active")

  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  location Location  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  bookings Booking[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([serviceId, locationId, startsAt, endsAt])
  @@index([locationId, startsAt, isActive])
  @@index([serviceId, startsAt])
  @@map("availability_slots")
}

model Booking {
  id            String @id @default(uuid()) @db.Uuid
  bookingNumber String @unique @map("booking_number") @db.VarChar(40)

  customerId String @map("customer_id") @db.Uuid
  serviceId  String @map("service_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid
  addressId  String @map("address_id") @db.Uuid
  slotId     String @map("slot_id") @db.Uuid

  status BookingStatus @default(PENDING)

  customerNotes String? @map("customer_notes") @db.Text

  amount   Decimal? @db.Decimal(12, 2)
  currency String   @default("INR") @db.Char(3)

  customer Profile          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service  Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  location Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  address  Address          @relation(fields: [addressId], references: [id], onDelete: Restrict)
  slot     AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Restrict)

  statusHistory BookingStatusHistory[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([slotId])
  @@index([serviceId, locationId])
  @@map("bookings")
}

model BookingStatusHistory {
  id        String @id @default(uuid()) @db.Uuid
  bookingId String @map("booking_id") @db.Uuid

  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")

  changedByProfileId String? @map("changed_by_profile_id") @db.Uuid

  note String? @db.Text

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedBy Profile? @relation("BookingStatusChangedBy", fields: [changedByProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

model Enquiry {
  id            String @id @default(uuid()) @db.Uuid
  enquiryNumber String @unique @map("enquiry_number") @db.VarChar(40)

  customerId String? @map("customer_id") @db.Uuid
  serviceId  String? @map("service_id") @db.Uuid
  locationId String? @map("location_id") @db.Uuid

  type   EnquiryType
  status EnquiryStatus @default(NEW)

  contactName  String @map("contact_name") @db.VarChar(160)
  contactEmail String @map("contact_email") @db.VarChar(255)
  contactPhone String @map("contact_phone") @db.VarChar(20)

  companyName  String? @map("company_name") @db.VarChar(180)
  projectTitle String? @map("project_title") @db.VarChar(200)

  description String @db.Text

  estimatedBudget Decimal? @map("estimated_budget") @db.Decimal(12, 2)

  preferredDate DateTime? @map("preferred_date") @db.Timestamptz(3)

  customer   Profile?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  service    Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  location   Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  quotations Quotation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([type])
  @@map("enquiries")
}

model Quotation {
  id String @id @default(uuid()) @db.Uuid

  quotationNumber String @unique @map("quotation_number") @db.VarChar(40)

  enquiryId String @map("enquiry_id") @db.Uuid

  version Int @default(1)

  status QuotationStatus @default(DRAFT)

  subtotal    Decimal @default(0) @db.Decimal(12, 2)
  taxAmount   Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount Decimal @default(0) @map("total_amount") @db.Decimal(12, 2)

  currency String @default("INR") @db.Char(3)

  validUntil DateTime? @map("valid_until") @db.Timestamptz(3)
  terms      String?   @db.Text

  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)

  enquiry Enquiry         @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  items   QuotationItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([enquiryId, version])
  @@index([status, createdAt])
  @@map("quotations")
}

model QuotationItem {
  id String @id @default(uuid()) @db.Uuid

  quotationId String @map("quotation_id") @db.Uuid

  description String @db.VarChar(255)

  quantity  Decimal @db.Decimal(10, 2)
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(12, 2)

  sortOrder Int @default(0) @map("sort_order")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}
