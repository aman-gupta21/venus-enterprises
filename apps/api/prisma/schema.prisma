generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------
// ENUMS
// ------------------------------

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF

  @@map("user_role")
}

enum BookingType {
  BOOK_VISIT
  REQUEST_QUOTE
  ENQUIRY

  @@map("booking_type")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED

  @@map("booking_status")
}

enum EnquiryType {
  REQUEST_QUOTE
  GENERAL_ENQUIRY

  @@map("enquiry_type")
}

enum EnquiryStatus {
  NEW
  UNDER_REVIEW
  CONTACTED
  QUOTATION_SENT
  ACCEPTED
  CLOSED
  REJECTED

  @@map("enquiry_status")
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED

  @@map("quotation_status")
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("payment_status")
}

enum PaymentMethod {
  RAZORPAY
  UPI
  CARD
  NET_BANKING
  CASH
  BANK_TRANSFER

  @@map("payment_method")
}

enum NotificationType {
  BOOKING
  PAYMENT
  QUOTATION
  ENQUIRY
  GENERAL

  @@map("notification_type")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS

  @@map("notification_channel")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ

  @@map("notification_status")
}

// ------------------------------
// CUSTOMER PROFILES
// ------------------------------

model Profile {
  id       String   @id @db.Uuid
  fullName String?  @map("full_name") @db.VarChar(160)
  phone    String?  @unique @db.VarChar(20)
  role     UserRole @default(CUSTOMER)
  isActive Boolean  @default(true) @map("is_active")

  addresses     Address[]
  bookings      Booking[]
  enquiries     Enquiry[]
  statusChanges BookingStatusHistory[] @relation("BookingStatusChangedBy")
  notifications Notification[]
  reviews       Review[]
  auditLogs     AuditLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

// ------------------------------
// CUSTOMER ADDRESSES
// ------------------------------

model Address {
  id        String @id @default(uuid()) @db.Uuid
  profileId String @map("profile_id") @db.Uuid

  label    String? @db.VarChar(50)
  line1    String  @map("line_1") @db.VarChar(255)
  line2    String? @map("line_2") @db.VarChar(255)
  landmark String? @db.VarChar(150)

  city       String @db.VarChar(100)
  state      String @db.VarChar(100)
  postalCode String @map("postal_code") @db.VarChar(12)
  country    String @default("India") @db.VarChar(100)

  isDefault Boolean @default(false) @map("is_default")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  bookings Booking[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([profileId])
  @@map("addresses")
}

// ------------------------------
// SERVICE CATEGORIES
// ------------------------------

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(150)
  slug        String  @unique @db.VarChar(180)
  description String? @db.Text
  imageUrl    String? @map("image_url") @db.Text

  parentId String? @map("parent_id") @db.Uuid

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  parent Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)

  children Category[] @relation("CategoryTree")
  services Service[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

// ------------------------------
// SERVICES
// ------------------------------

model Service {
  id         String @id @default(uuid()) @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  name             String  @db.VarChar(180)
  slug             String  @unique @db.VarChar(200)
  shortDescription String? @map("short_description") @db.VarChar(300)
  description      String? @db.Text
  imageUrl         String? @map("image_url") @db.Text

  bookingType BookingType @default(REQUEST_QUOTE) @map("booking_type")

  basePrice       Decimal? @map("base_price") @db.Decimal(12, 2)
  currency        String   @default("INR") @db.Char(3)
  durationMinutes Int?     @map("duration_minutes")

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  locations         ServiceLocation[]
  bookings          Booking[]
  availabilitySlots AvailabilitySlot[]
  enquiries         Enquiry[]
  reviews           Review[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([isActive, sortOrder])
  @@map("services")
}

// ------------------------------
// SERVICE LOCATIONS
// ------------------------------

model Location {
  id String @id @default(uuid()) @db.Uuid

  city    String @db.VarChar(100)
  state   String @db.VarChar(100)
  country String @default("India") @db.VarChar(100)

  slug     String  @unique @db.VarChar(180)
  isActive Boolean @default(true) @map("is_active")

  services          ServiceLocation[]
  bookings          Booking[]
  availabilitySlots AvailabilitySlot[]
  enquiries         Enquiry[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("locations")
}

model ServiceLocation {
  serviceId  String @map("service_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid

  isActive Boolean @default(true) @map("is_active")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([serviceId, locationId])
  @@index([locationId])
  @@map("service_locations")
}

// ------------------------------
// INITIAL SYSTEM CHECK
// ------------------------------

model SystemCheck {
  id        String   @id @default(uuid())
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_checks")
}

model AvailabilitySlot {
  id         String @id @default(uuid()) @db.Uuid
  serviceId  String @map("service_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid

  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)

  capacity    Int     @default(1)
  bookedCount Int     @default(0) @map("booked_count")
  isActive    Boolean @default(true) @map("is_active")

  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  location Location  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  bookings Booking[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([serviceId, locationId, startsAt, endsAt])
  @@index([locationId, startsAt, isActive])
  @@index([serviceId, startsAt])
  @@map("availability_slots")
}

model Booking {
  id            String @id @default(uuid()) @db.Uuid
  bookingNumber String @unique @map("booking_number") @db.VarChar(40)

  customerId String @map("customer_id") @db.Uuid
  serviceId  String @map("service_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid
  addressId  String @map("address_id") @db.Uuid
  slotId     String @map("slot_id") @db.Uuid

  status BookingStatus @default(PENDING)

  customerNotes String? @map("customer_notes") @db.Text

  amount   Decimal? @db.Decimal(12, 2)
  currency String   @default("INR") @db.Char(3)

  customer Profile          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service  Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  location Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  address  Address          @relation(fields: [addressId], references: [id], onDelete: Restrict)
  slot     AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Restrict)

  statusHistory BookingStatusHistory[]
  payments      Payment[]
  review        Review?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([slotId])
  @@index([serviceId, locationId])
  @@map("bookings")
}

model BookingStatusHistory {
  id        String @id @default(uuid()) @db.Uuid
  bookingId String @map("booking_id") @db.Uuid

  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")

  changedByProfileId String? @map("changed_by_profile_id") @db.Uuid

  note String? @db.Text

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedBy Profile? @relation("BookingStatusChangedBy", fields: [changedByProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

model Enquiry {
  id            String @id @default(uuid()) @db.Uuid
  enquiryNumber String @unique @map("enquiry_number") @db.VarChar(40)

  customerId String? @map("customer_id") @db.Uuid
  serviceId  String? @map("service_id") @db.Uuid
  locationId String? @map("location_id") @db.Uuid

  type   EnquiryType
  status EnquiryStatus @default(NEW)

  contactName  String @map("contact_name") @db.VarChar(160)
  contactEmail String @map("contact_email") @db.VarChar(255)
  contactPhone String @map("contact_phone") @db.VarChar(20)

  companyName  String? @map("company_name") @db.VarChar(180)
  projectTitle String? @map("project_title") @db.VarChar(200)

  description String @db.Text

  estimatedBudget Decimal? @map("estimated_budget") @db.Decimal(12, 2)

  preferredDate DateTime? @map("preferred_date") @db.Timestamptz(3)

  customer   Profile?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  service    Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  location   Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  quotations Quotation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([type])
  @@map("enquiries")
}

model Quotation {
  id String @id @default(uuid()) @db.Uuid

  quotationNumber String @unique @map("quotation_number") @db.VarChar(40)

  enquiryId String @map("enquiry_id") @db.Uuid

  version Int @default(1)

  status QuotationStatus @default(DRAFT)

  subtotal    Decimal @default(0) @db.Decimal(12, 2)
  taxAmount   Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount Decimal @default(0) @map("total_amount") @db.Decimal(12, 2)

  currency String @default("INR") @db.Char(3)

  validUntil DateTime? @map("valid_until") @db.Timestamptz(3)
  terms      String?   @db.Text

  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)

  enquiry  Enquiry         @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  items    QuotationItem[]
  payments Payment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([enquiryId, version])
  @@index([status, createdAt])
  @@map("quotations")
}

model QuotationItem {
  id String @id @default(uuid()) @db.Uuid

  quotationId String @map("quotation_id") @db.Uuid

  description String @db.VarChar(255)

  quantity  Decimal @db.Decimal(10, 2)
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(12, 2)

  sortOrder Int @default(0) @map("sort_order")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

model Payment {
  id String @id @default(uuid()) @db.Uuid

  paymentNumber String @unique @map("payment_number") @db.VarChar(50)

  bookingId   String? @map("booking_id") @db.Uuid
  quotationId String? @map("quotation_id") @db.Uuid

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("INR") @db.Char(3)

  status PaymentStatus  @default(CREATED)
  method PaymentMethod?

  providerOrderId   String? @unique @map("provider_order_id") @db.VarChar(150)
  providerPaymentId String? @unique @map("provider_payment_id") @db.VarChar(150)

  idempotencyKey String @unique @map("idempotency_key") @db.VarChar(100)

  failureReason String? @map("failure_reason") @db.Text

  paidAt     DateTime? @map("paid_at") @db.Timestamptz(3)
  refundedAt DateTime? @map("refunded_at") @db.Timestamptz(3)

  booking   Booking?   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  quotation Quotation? @relation(fields: [quotationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([bookingId])
  @@index([quotationId])
  @@map("payments")
}

model Notification {
  id String @id @default(uuid()) @db.Uuid

  profileId String? @map("profile_id") @db.Uuid

  type    NotificationType
  channel NotificationChannel
  status  NotificationStatus  @default(PENDING)

  title   String @db.VarChar(180)
  message String @db.Text

  recipient   String? @db.VarChar(255)
  referenceId String? @map("reference_id") @db.Uuid

  sentAt DateTime? @map("sent_at") @db.Timestamptz(3)
  readAt DateTime? @map("read_at") @db.Timestamptz(3)

  profile Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([profileId, createdAt])
  @@index([status, createdAt])
  @@index([type])
  @@map("notifications")
}

model Review {
  id String @id @default(uuid()) @db.Uuid

  profileId String @map("profile_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  bookingId String @unique @map("booking_id") @db.Uuid

  rating  Int
  comment String? @db.Text

  isPublished Boolean @default(false) @map("is_published")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([serviceId, isPublished])
  @@index([profileId])
  @@map("reviews")
}

model Client {
  id String @id @default(uuid()) @db.Uuid

  name        String  @db.VarChar(180)
  slug        String  @unique @db.VarChar(200)
  logoUrl     String? @map("logo_url") @db.Text
  description String? @db.Text

  websiteUrl String? @map("website_url") @db.Text

  isActive Boolean @default(true) @map("is_active")

  projects Project[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("clients")
}

model Project {
  id String @id @default(uuid()) @db.Uuid

  clientId String? @map("client_id") @db.Uuid

  title       String  @db.VarChar(200)
  slug        String  @unique @db.VarChar(220)
  description String? @db.Text

  location String? @db.VarChar(180)
  industry String? @db.VarChar(120)

  coverImageUrl String? @map("cover_image_url") @db.Text

  isFeatured  Boolean @default(false) @map("is_featured")
  isPublished Boolean @default(false) @map("is_published")

  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isPublished, isFeatured])
  @@index([clientId])
  @@map("projects")
}

model Certification {
  id String @id @default(uuid()) @db.Uuid

  name        String  @db.VarChar(180)
  description String? @db.Text

  certificateNumber String? @map("certificate_number") @db.VarChar(100)

  documentUrl String? @map("document_url") @db.Text

  issuedBy String? @map("issued_by") @db.VarChar(180)

  issuedAt  DateTime? @map("issued_at") @db.Timestamptz(3)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("certifications")
}

model Faq {
  id String @id @default(uuid()) @db.Uuid

  question String @db.VarChar(255)
  answer   String @db.Text

  category String? @db.VarChar(120)

  sortOrder Int @default(0) @map("sort_order")

  isPublished Boolean @default(true) @map("is_published")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("faqs")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  actorId String? @map("actor_id") @db.Uuid

  action     String  @db.VarChar(120)
  entityType String  @map("entity_type") @db.VarChar(120)
  entityId   String? @map("entity_id") @db.Uuid

  metadata Json?

  ipAddress String? @map("ip_address") @db.VarChar(45)

  actor Profile? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
